    "Adult categories (WHO Asian action points): underweight below 18.5, healthy weight 18.5 to under 23, overweight 23 to under 27.5, obesity 27.5 and above (this app lists all of these as Obesity (class 1) and does not split higher classes)." : {
      "comment" : "Doctor summary PDF method note. Use your language's decimal separator in the numbers. Obesity (class 1) must match the app's category name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Categorías para adultos (puntos de acción de la OMS para poblaciones asiáticas): Peso insuficiente, menos de 18,5; Peso normal, de 18,5 a menos de 23; Sobrepeso, de 23 a menos de 27,5; Obesidad, 27,5 o más (esta app incluye todos estos valores en Obesidad (clase 1) y no distingue clases superiores)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catégories pour adultes (seuils d'action de l'OMS pour les populations asiatiques) : insuffisance pondérale en dessous de 18,5, poids normal de 18,5 à moins de 23, surpoids de 23 à moins de 27,5, obésité à partir de 27,5 (cette app classe toutes ces valeurs en Obésité (classe 1) et ne distingue pas les classes supérieures)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Categorias para adultos (pontos de ação da OMS para populações asiáticas): baixo peso abaixo de 18,5; peso normal de 18,5 a menos de 23; sobrepeso de 23 a menos de 27,5; obesidade a partir de 27,5 (este app classifica todos esses valores como Obesidade (classe 1) e não separa as classes mais altas)."
          }
        }
      }
    },
    "Adult categories (WHO/CDC): underweight below 18.5, healthy weight 18.5 to under 25, overweight 25 to under 30, obesity 30 and above (class 1: 30 to under 35, class 2: 35 to under 40, class 3: 40 and above)." : {
      "comment" : "Doctor summary PDF method note. Use your language's decimal separator in the numbers. Category names must match the app's category names.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Categorías para adultos (OMS/CDC): Peso insuficiente, menos de 18,5; Peso normal, de 18,5 a menos de 25; Sobrepeso, de 25 a menos de 30; Obesidad, 30 o más (clase 1: de 30 a menos de 35; clase 2: de 35 a menos de 40; clase 3: 40 o más)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catégories pour adultes (OMS/CDC) : insuffisance pondérale en dessous de 18,5, poids normal de 18,5 à moins de 25, surpoids de 25 à moins de 30, obésité à partir de 30 (classe 1 : de 30 à moins de 35, classe 2 : de 35 à moins de 40, classe 3 : 40 et plus)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Categorias para adultos (OMS/CDC): baixo peso abaixo de 18,5; peso normal de 18,5 a menos de 25; sobrepeso de 25 a menos de 30; obesidade a partir de 30 (classe 1: de 30 a menos de 35; classe 2: de 35 a menos de 40; classe 3: a partir de 40)."
          }
        }
      }
    },
