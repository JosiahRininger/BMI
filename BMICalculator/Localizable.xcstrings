    },
    "These population-level cutoffs guide screening; they are not a personal diagnosis. Talk to a healthcare provider about what's right for you." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos puntos de corte a nivel poblacional orientan la detección; no son un diagnóstico personal. Consulta a un profesional de la salud sobre lo que es adecuado para ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces seuils, établis à l'échelle de la population, orientent le dépistage ; ils ne constituent pas un diagnostic personnel. Consultez un professionnel de santé pour savoir ce qui vous convient."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esses pontos de corte populacionais orientam a triagem; eles não são um diagnóstico pessoal. Consulte um profissional de saúde sobre o que é certo para você."
          }
        }
      }
    },
    "This is a screening number, not a diagnosis." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este valor es una medida de detección, no un diagnóstico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce chiffre sert au dépistage, ce n'est pas un diagnostic."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este é um número de triagem, não um diagnóstico."
          }
        }
      }
    },
