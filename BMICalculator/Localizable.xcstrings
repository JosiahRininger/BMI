    "BMI trend for the last 90 days. Latest %@. %@" : {
      "comment" : "VoiceOver label for the trend widget. Arguments: latest BMI, change since the first point (e.g. +0.4 since Jul 12).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
