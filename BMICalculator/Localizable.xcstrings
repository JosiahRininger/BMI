{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ · %@" : {
      "comment" : "Formatting only: a date, a separator dot, and a BMI range. Nothing to translate.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        }
      },
      "shouldTranslate" : false
    },
    "%@ · BMI %@ then, %@ now (%@)" : {
      "comment" : "History, since the first entry. Arguments: first entry date, first BMI, latest BMI, signed change (e.g. +0.4).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · BMI %2$@ then, %3$@ now (%4$@)"
          }
        }
      }
    },
    "%@ cm" : {
      "comment" : "A height in centimeters, e.g. 175 cm."
    },
    "%@ in" : {
      "comment" : "Height in half inches, e.g. 7.5 in. Shown in a picker wheel."
    },
    "%@ kg" : {
      "comment" : "A weight in kilograms, e.g. 72.4 kg."
    },
    "%@ lb" : {
      "comment" : "A weight in pounds, e.g. 154.3 lb."
    },
    "%@ since %@" : {
      "comment" : "Trend widget: BMI change since the first point, e.g. +0.4 since Jul 12. Small widget: keep it short.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ since %2$@"
          }
        }
      }
    },
    "%@ to %@" : {
