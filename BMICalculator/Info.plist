<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Partial Info.plist. GENERATE_INFOPLIST_FILE stays YES, so Xcode merges the
	  build-setting-derived keys (versions, scene manifest, launch screen, the
	  HealthKit usage strings from INFOPLIST_KEY_*) on top of this base. The only
	  thing that can't be expressed as an INFOPLIST_KEY scalar is the URL-types
	  array below, which registers the bmicalculator:// scheme the widget, Control
	  Center control, and App Shortcuts deep-link into.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.jdr.BMI</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>bmicalculator</string>
			</array>
		</dict>
	</array>

	<!--
	  Export compliance: the app uses only standard OS-provided encryption (HTTPS),
	  no custom/proprietary crypto, so it is exempt. Declaring NO lets every upload
	  skip the manual "missing compliance" prompt in App Store Connect / TestFlight.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!--
	  Google Mobile Ads (AdMob) application ID. REQUIRED: the SDK throws at
	  MobileAds.start() if this is missing. This is the app-level AdMob ID, NOT an
	  ad unit ID (those live in AdsManager.AdUnit). The ad layer is firewalled from
	  all health data and requests non-personalized ads only (Guideline 5.1.3).
	-->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-6687613409331343~7486203316</string>
</dict>
</plist>
